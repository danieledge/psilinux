# PsiLinux: what never goes in this repository.
# The builds write their output to the psiterm checkout this sits in
# (../build, ../dist), so little is generated here; this list is the net.

# Remote apps: not in this repository (yet)
/remote/

# Generated by makmake (they hold the builder's own paths)
*.marm
*.MARM

# Build output, wherever it lands
build/
dist/
*.o
*.obj
*.a
*.lib
*.exe
*.app
*.rsc
*.rsg
*.mbm
*.aif
*.bas
*.exp
*.map
*.tmp.exe
psihost

# Installers and images: GitHub Release assets, never committed
*.sis
*.SIS
*.sig
ROOT.IMG
*.IMG
*.img
*.iso

# Root file system work areas and downloads
stage/
sysroot/
ports-build/
psilinux-src/
psilinux-toolchain/
*.apk
APKINDEX*
*.tar
*.tar.gz
*.tgz
*.tar.xz
*.tar.bz2
*.zip

# Python, Node
__pycache__/
*.pyc
node_modules/

# Logs and test output
*.log
*.old
LxProbe.log
PsiLinux.log
BOOTLOG
TRACE
fuzz-out/
core
core.*

# Secrets and local settings: never
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
*.secret
secrets.*
