#!/bin/sh
# psilinux-login - root's login on the PsiLinux window (tty1, /etc/inittab).
# When the login shell ends (exit or ^D at the top shell), Linux ends too:
# OpenRC stops its services, every program is ended, and PsiLinux closes,
# back to where you were (PsiLinux 0.36).
/bin/login -f root
exec /sbin/poweroff
