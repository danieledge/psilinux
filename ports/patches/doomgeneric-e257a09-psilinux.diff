diff -ruN a/doomgeneric/r_draw.c b/doomgeneric/r_draw.c
--- a/doomgeneric/r_draw.c	2026-10-30 23:54:58.483901951 +0000
+++ b/doomgeneric/r_draw.c	2026-10-31 09:23:22.392839617 +0000
@@ -99,6 +99,54 @@
 // Thus a special case loop for very fast rendering can
 //  be used. It has also been used with Wolfenstein 3D.
 // 
+#ifdef PSILINUX
+// PsiLinux (an ARM710T, where these loops are half of every frame): the
+// globals in locals (else GCC loads dc_source and dc_colormap again after
+// every byte stored, as the store might have changed them), frac kept shifted
+// up 9 so that frac >> 25 is the texture row (mod 128) with no AND (an LDRB
+// with a shifted index), and four pixels a turn of the loop.
+void R_DrawColumn (void)
+{
+    int			count;
+    byte*		dest;
+    const byte*		source = dc_source;
+    const lighttable_t*	colormap = dc_colormap;
+    unsigned int	frac;
+    unsigned int	fracstep;
+
+    count = dc_yh - dc_yl;
+    if (count < 0)
+	return;
+
+#ifdef RANGECHECK
+    if ((unsigned)dc_x >= SCREENWIDTH
+	|| dc_yl < 0
+	|| dc_yh >= SCREENHEIGHT)
+	I_Error ("R_DrawColumn: %i to %i at %i", dc_yl, dc_yh, dc_x);
+#endif
+
+    dest = ylookup[dc_yl] + columnofs[dc_x];
+    fracstep = (unsigned int) dc_iscale << 9;
+    frac = (unsigned int) (dc_texturemid + (dc_yl-centery)*dc_iscale) << 9;
+    count++;
+
+    while (count >= 4)
+    {
+	dest[0] = colormap[source[frac >> 25]]; frac += fracstep;
+	dest[SCREENWIDTH] = colormap[source[frac >> 25]]; frac += fracstep;
+	dest[SCREENWIDTH*2] = colormap[source[frac >> 25]]; frac += fracstep;
+	dest[SCREENWIDTH*3] = colormap[source[frac >> 25]]; frac += fracstep;
+	dest += SCREENWIDTH*4;
+	count -= 4;
+    }
+    while (count--)
+    {
+	*dest = colormap[source[frac >> 25]];
+	dest += SCREENWIDTH;
+	frac += fracstep;
+    }
+}
+#else
 void R_DrawColumn (void) 
 { 
     int			count; 
@@ -143,6 +191,7 @@
 	
     } while (count--); 
 } 
+#endif
 
 
 
