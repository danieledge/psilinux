+/*
+ * PsiLinux: with -fb naming a plain file (e.g. one made by
+ * "head -c 154368 /dev/zero > fb.raw"), the frame buffer is that file,
+ * 640x240 at 8 bits, with the colour map as 256 RGB bytes after the pixels:
+ * enough to run and screenshot the server where there is no /dev/fb0.
+ * Size and depth can be set with PSIX_FB=WxHxD.
+ */
+static int
+fbdevIoctl(FbdevPriv * priv, unsigned long req, void *arg)
+{
+    if (!priv->isfile)
+        return ioctl(priv->fd, req, arg);
+    switch (req) {
+    case FBIOGET_FSCREENINFO:
+        *(struct fb_fix_screeninfo *) arg = priv->fix;
+        return 0;
+    case FBIOGET_VSCREENINFO:
+        *(struct fb_var_screeninfo *) arg = priv->var;
+        return 0;
+    case FBIOPUT_VSCREENINFO: {
+        struct fb_var_screeninfo *v = arg;
+
+        if (v->xres != priv->var.xres || v->yres != priv->var.yres ||
+            v->bits_per_pixel != priv->var.bits_per_pixel) {
+            errno = EINVAL;
+            return -1;
+        }
+        return 0;
+    }
+    case FBIOPUTCMAP:
+    case FBIOGETCMAP: {
+        struct fb_cmap *c = arg;
+        unsigned char rgb[3];
+        unsigned i;
+        off_t at = priv->fix.smem_len;
+
+        for (i = 0; i < c->len && c->start + i < 256; i++) {
+            off_t o = at + 3 * (c->start + i);
+            if (req == FBIOPUTCMAP) {
+                rgb[0] = c->red[i] >> 8;
+                rgb[1] = c->green[i] >> 8;
+                rgb[2] = c->blue[i] >> 8;
+                if (pwrite(priv->fd, rgb, 3, o) != 3)
+                    return -1;
+            }
+            else {
+                if (pread(priv->fd, rgb, 3, o) != 3)
+                    rgb[0] = rgb[1] = rgb[2] = 0;
+                c->red[i] = rgb[0] * 257;
+                c->green[i] = rgb[1] * 257;
+                c->blue[i] = rgb[2] * 257;
+            }
+        }
+        return 0;
+    }
+    case PSIFB_DAMAGE:
+        if (getenv("PSIX_DAMAGE_LOG")) {
+            struct psifb_rect *r = arg;
+            ErrorF("damage %d,%d %dx%d\n", r->x, r->y, r->w, r->h);
+        }
+        return 0;
+    default:
+        errno = ENOTTY;
+        return -1;
+    }
+}
+
+static void
+fbdevFileInit(FbdevPriv * priv)
+{
+    unsigned w = 640, h = 240, d = 8;
+    const char *e = getenv("PSIX_FB");
+
+    if (e)
+        sscanf(e, "%ux%ux%u", &w, &h, &d);
+    memset(&priv->fix, 0, sizeof(priv->fix));
+    memset(&priv->var, 0, sizeof(priv->var));
+    strcpy(priv->fix.id, "psifile");
+    priv->fix.type = FB_TYPE_PACKED_PIXELS;
+    priv->fix.visual = d <= 8 ? FB_VISUAL_PSEUDOCOLOR : FB_VISUAL_TRUECOLOR;
+    priv->fix.line_length = w * d / 8;
+    priv->fix.smem_len = priv->fix.line_length * h;
+    priv->var.xres = priv->var.xres_virtual = w;
+    priv->var.yres = priv->var.yres_virtual = h;
+    priv->var.bits_per_pixel = d;
+    if (d == 16) {
+        priv->var.red.offset = 11;  priv->var.red.length = 5;
+        priv->var.green.offset = 5; priv->var.green.length = 6;
+        priv->var.blue.length = 5;
+    }
+    /* room for the pixels and the colour map */
+    if (ftruncate(priv->fd, priv->fix.smem_len + 768) < 0)
+        perror("ftruncate");
+}
 
