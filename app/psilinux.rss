// The standard toolbar: the program's name, four buttons for the pen, the
// clock. Stop sends Ctrl+C (the key a terminal user reaches for most), Keys
// pops up the keys the Psion has none for, Copy and Paste the clipboard. The
// pictures come from PsiLinux.mbm (linux/tools/mkicons.py). View > Show
// toolbar (Shift+Ctrl+B, as PsiTerm: Ctrl+T must reach Linux) hides it.
RESOURCE TOOLBAR r_lx_toolbar
	{
	breadth=KEikStdToolBarWidth;
	controls=
		{
		TBAR_CTRL
			{
			type=EEikCtLabel;
			flags=EEikToolBarCtrlHasSetMinLength;
			length=KEikStdFileNameLabelHeight;
			control=LABEL { txt="PsiLinux"; horiz_align=EEikLabelAlignHCenter; vert_align=EEikLabelAlignVCenter; };
			},
		TBAR_BUTTON { id=ELxCmdTbStop; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Stop"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_CTRL
			{
			type=EEikCtMenuButton; id=ELxCmdTbKeys;
			flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight;
			control=MNBUT { popout=r_lx_keys_popup; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Keys"; };
			},
		TBAR_BUTTON { id=ELxCmdTbCopy; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Copy"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_BUTTON { id=ELxCmdTbPaste; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Paste"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_CTRL
			{
			type=EEikCtSpacer;
			flags=EEikToolBarCtrlHasSetMinLength|EEikToolBarCtrlIsStretchable;
			length=0;
			control=SPACER;
			},
		TBAR_CTRL
			{
			type=EEikCtClock;
			control=CLOCK { digitalresourceid=R_EIK_DIGITAL_CLOCK; analogresourceid=R_EIK_ANALOG_CLOCK; };
			},
		TBAR_CTRL
			{
			type=EEikCtSpacer;
			flags=EEikToolBarCtrlHasSetMinLength;
			length=KEikStdGapBelowClock;
			control=SPACER;
			}
		};
	}

// the toolbar's Keys button (no shortcuts: it is for the pen)
RESOURCE MENU_PANE r_lx_keys_popup
	{
	items=
		{
		MENU_ITEM { command=ELxCmdKeyEsc; txt="Esc"; },
		MENU_ITEM { command=ELxCmdKeyTab; txt="Tab"; },
		MENU_ITEM { command=ELxCmdKeyBar; txt="|"; },
		MENU_ITEM { command=ELxCmdKeyTilde; txt="~"; },
		MENU_ITEM { command=ELxCmdKeyCtrlZ; txt="Ctrl+Z"; },
		MENU_ITEM { command=ELxCmdKeyCtrlD; txt="Ctrl+D"; },
		MENU_ITEM { command=ELxCmdKeyCtrlBackslash; txt="Ctrl+\\"; }
		};
	}

// Shortcuts. As in PsiTerm, every plain Ctrl+letter must reach Linux (Ctrl+C,
// Ctrl+D, Ctrl+Z, Ctrl+R...), so PsiLinux's own shortcuts are Shift+Ctrl+
// letter, with the standard letter where there is one (E close, C copy,
// V paste, M zoom out, K preferences, H help, A about), N for Start (create
// new), D for End (as Email's close mailbox) and I for "|", which the 5mx's
// keyboard has no key for (the letter looks like it; Merge in has no place
// here). The one exception is
// Ctrl+Q, Switch view, as the style guide has it.
RESOURCE HOTKEYS r_lx_hotkeys
	{
	control=
		{
		HOTKEY { command=ELxCmdSwitchView; key='q'; }
		};
	shift_control=
		{
		HOTKEY { command=EEikCmdExit; key='e'; },
		HOTKEY { command=ELxCmdStart; key='n'; },
		HOTKEY { command=ELxCmdEnd; key='d'; },
		HOTKEY { command=ELxCmdKeyBar; key='i'; },
		HOTKEY { command=ELxCmdToolbar; key='b'; },
		HOTKEY { command=ELxCmdCopy; key='c'; },
		HOTKEY { command=ELxCmdPaste; key='v'; },
		HOTKEY { command=ELxCmdZoomOut; key='m'; },
		HOTKEY { command=ELxCmdPreferences; key='k'; },
		HOTKEY { command=ELxCmdHelp; key='h'; },
		HOTKEY { command=ELxCmdAbout; key='a'; }
		};
	}

