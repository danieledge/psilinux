 //
 // Draws the actual span.
+#ifdef PSILINUX
+// (locals for the globals, as R_DrawColumn, and four pixels a turn)
+void R_DrawSpan (void)
+{
+    unsigned int position, step;
+    byte *dest;
+    const byte *source = ds_source;
+    const lighttable_t *colormap = ds_colormap;
+    int count;
+
+#ifdef RANGECHECK
+    if (ds_x2 < ds_x1
+	|| ds_x1<0
+	|| ds_x2>=SCREENWIDTH
+	|| (unsigned)ds_y>SCREENHEIGHT)
+    {
+	I_Error( "R_DrawSpan: %i to %i at %i",
+		 ds_x1,ds_x2,ds_y);
+    }
+#endif
+
+    position = ((ds_xfrac << 10) & 0xffff0000)
+             | ((ds_yfrac >> 6)  & 0x0000ffff);
+    step = ((ds_xstep << 10) & 0xffff0000)
+         | ((ds_ystep >> 6)  & 0x0000ffff);
+
+    dest = ylookup[ds_y] + columnofs[ds_x1];
+    count = ds_x2 - ds_x1 + 1;
+
+    // (the mask in a register: one AND with a shifted operand, not two)
+    unsigned int m = 0x0fc0;
+    __asm__ ("" : "+r" (m));
+#define SPOT(p) ((((p) >> 4) & m) | ((p) >> 26))
+    while (count >= 4)
+    {
+	dest[0] = colormap[source[SPOT(position)]]; position += step;
+	dest[1] = colormap[source[SPOT(position)]]; position += step;
+	dest[2] = colormap[source[SPOT(position)]]; position += step;
+	dest[3] = colormap[source[SPOT(position)]]; position += step;
+	dest += 4;
+	count -= 4;
+    }
+    while (count--)
+    {
+	*dest++ = colormap[source[SPOT(position)]];
+	position += step;
+    }
+}
+#else
 void R_DrawSpan (void) 
 { 
     unsigned int position, step;
@@ -637,6 +780,7 @@
 
     } while (count--);
 }
+#endif
 
 
 
