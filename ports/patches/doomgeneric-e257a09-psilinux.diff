        // If playing single player, do not allow tics to buffer
        // up very far
 
+#ifdef PSILINUX
+       // (a slow machine: up to 7 tics a frame, so that the game keeps
+       // time down to 5 frames a second instead of slowing down below 12)
+       if (!net_client_connected && maketic - gameticdiv > 6)
+           return false;
+#else
        if (!net_client_connected && maketic - gameticdiv > 2)
            return false;
+#endif
 
        // Never go more than ~200ms ahead
 
@@ -781,7 +788,17 @@
 	    return;
 	}
 
+#ifdef PSILINUX
+        // sleep until the next tic, not a millisecond at a time (the
+        // Psion's clock ticks every 15.6 ms anyway)
+        {
+            int next = ((I_GetTime() + 1) * 1000 + TICRATE - 1) / TICRATE;
+            int ms = next - I_GetTimeMS();
+            I_Sleep(ms > 0 ? ms : 1);
+        }
+#else
         I_Sleep(1);
+#endif
     }
 
     // run the count * ticdup dics
