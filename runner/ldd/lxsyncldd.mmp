TARGETTYPE      ldd
UID             0x100000ae 0x01000AAD
PROJECT         ptproj
SUBPROJECT      lxsyncldd
SOURCE          lxsyncldd.cpp
USERINCLUDE     \ptproj\lxsyncldd
