// PSILINUX.MMP - PsiLinux (the app; the runner is linux/runner/Makefile)
TARGET        psilinux.app
TARGETTYPE    app
UID           0x1000006c 0x01000A87
TARGETPATH    \system\apps\psilinux

PROJECT       ptproj
SUBPROJECT    psilinux
SOURCE        psilinux.cpp lxterm.cpp lxptview.cpp lxglyphs.cpp lxhelp.cpp lxscreen.cpp lxtermsb.cpp lxepocsv.cpp
RESOURCE      psilinux.rss

// (0.48) psion-core's ssh headers before PsiTerm's app folder: PsiTerm 1.18
// on keeps an older copy of psierr.h there (no PsiErrTail), and PsiLinux
// takes psierr.h from psion-core (the two folders share no other header).
USERINCLUDE   \ptproj\psilinux \ptproj\psilxssh \ptproj\psilxterm \ptproj\psilxterm\vterm \ptproj\psilxcommon
SYSTEMINCLUDE \ptproj\psilxterm\vterm \epoc32\include\libc \epoc32\include

LIBRARY       psivterm.lib
LIBRARY       euser.lib efsrv.lib apparc.lib cone.lib eikon.lib ws32.lib gdi.lib
LIBRARY       bafl.lib etext.lib estor.lib fbscli.lib estlib.lib apgrfx.lib apmime.lib
