# PsiLinux's changes to BusyBox's defconfig (build-rootfs.sh applies them).
# No MMU: vfork, not fork (ash, hush and the rest know how)
CONFIG_NOMMU=y
# lx-cc builds static-pie itself
# CONFIG_STATIC is not set
# CONFIG_PIE is not set
CONFIG_EXTRA_CFLAGS="-Os"
# simple applets (echo, test, printf, pwd, true...) run inside the shell: no new program
CONFIG_FEATURE_SH_NOFORK=y
# no SELinux, no PAM, no kernel modules on a Psion
# CONFIG_SELINUX is not set
# CONFIG_PAM is not set
# CONFIG_MODPROBE_SMALL is not set
# CONFIG_INSMOD is not set
# CONFIG_RMMOD is not set
# CONFIG_LSMOD is not set
# CONFIG_MODPROBE is not set
# CONFIG_DEPMOD is not set
# applets of no use on a Psion (init systems, disks, kernel modules, daemons, raw sockets...)
# CONFIG_ACPID is not set
# CONFIG_ADDGROUP is not set
