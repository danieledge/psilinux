diff -ruN musl-orig/arch/arm/syscall_arch.h musl-1.2.6/arch/arm/syscall_arch.h
--- musl-orig/arch/arm/syscall_arch.h	2026-03-20 15:40:00.000000000 +0000
+++ musl-1.2.6/arch/arm/syscall_arch.h	2026-10-14 08:00:13.223562160 +0100
@@ -9,17 +9,20 @@
  * since it's reserved as frame pointer and might not be supported. */
 #define __ASM____R7__
 #define __asm_syscall(...) do { \
-	__asm__ __volatile__ ( "mov %1,r7 ; mov r7,%2 ; svc 0 ; mov r7,%1" \
-	: "=r"(r0), "=&r"((int){0}) : __VA_ARGS__ : "memory"); \
+	__asm__ __volatile__ ( "mov %1,r7 ; mov r7,%2 ; bl __psi_svc ; mov r7,%1" \
+	: "=r"(r0), "=&r"((int){0}) : __VA_ARGS__ : "memory", "cc", "lr", "ip"); \
 	return r0; \
 	} while (0)
 
 #else
 
 #define __ASM____R7__ __asm__("r7")
+/* PsiLinux: no svc in the program. __psi_svc (src/internal/arm/psi_svc.s)
+ * enters the PsiLinux runner, or does the svc on a real Linux kernel. It
+ * keeps the registers an svc keeps, but a call changes lr, ip and the flags. */
 #define __asm_syscall(...) do { \
-	__asm__ __volatile__ ( "svc 0" \
-	: "=r"(r0) : __VA_ARGS__ : "memory"); \
+	__asm__ __volatile__ ( "bl __psi_svc" \
+	: "=r"(r0) : __VA_ARGS__ : "memory", "cc", "lr", "ip"); \
 	return r0; \
 	} while (0)
 #endif
diff -ruN musl-orig/src/internal/arm/psi_svc.s musl-1.2.6/src/internal/arm/psi_svc.s
--- musl-orig/src/internal/arm/psi_svc.s	1970-01-01 01:00:00.000000000 +0100
+++ musl-1.2.6/src/internal/arm/psi_svc.s	2026-10-14 08:00:25.566868365 +0100
@@ -0,0 +1,35 @@
+@ PsiLinux: the only place a Linux system call is made.
+@ Called (bl) with the registers of an svc: r0-r6 the arguments, r7 the
+@ number. Under the PsiLinux runner, __sysinfo (AT_SYSINFO) points at the
+@ runner's table, whose first word is its system call entry: that is entered
+@ with these registers and lr, and returns like an svc (r0 the result, every
+@ other register kept but ip, lr and the flags). On a real Linux kernel
+@ (qemu-arm, or a Linux ARM board) __sysinfo is 0 and this is an svc.
+@ EPOC must never see an svc: on EPOC R5 it is an executive call, and svc 0
+@ restarts the machine (linux/docs/DESIGN.md).
+.syntax unified
+.text
+.global __psi_svc
+.hidden __psi_svc
+.type __psi_svc,%function
+__psi_svc:
+	ldr ip, 1f
+2:	add ip, pc, ip
+	ldr ip, [ip]
+	cmp ip, #0
+	ldrne pc, [ip]
+	svc 0
+	bx lr
+	.align 2
+1:	.word __sysinfo - 2b - 8
+
+@ The PsiLinux ABI note, which the runner looks for (linux/docs/DESIGN.md):
+@ name "PsiLinux", type 1, and the ABI version (1) as its description.
+.section .note.psilinux,"a",%note
+	.align 2
+	.word 9
+	.word 4
+	.word 1
+	.asciz "PsiLinux"
+	.align 2
+	.word 1
diff -ruN musl-orig/src/process/arm/vfork.s musl-1.2.6/src/process/arm/vfork.s
--- musl-orig/src/process/arm/vfork.s	2026-03-20 15:40:00.000000000 +0000
+++ musl-1.2.6/src/process/arm/vfork.s	2026-10-14 08:00:13.223562160 +0100
@@ -2,9 +2,13 @@
 .global vfork
 .type vfork,%function
 vfork:
-	mov ip, r7
+	@ PsiLinux: lr and r7 are kept in r2 and r3, not on the stack, which the
+	@ child shares (and overwrites) until it calls execve or _exit
+	mov r3, r7
+	mov r2, lr
 	mov r7, 190
-	svc 0
-	mov r7, ip
+	bl __psi_svc
+	mov r7, r3
+	mov lr, r2
 	.hidden __syscall_ret
 	b __syscall_ret
