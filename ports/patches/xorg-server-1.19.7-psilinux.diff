+/*
+ * PsiLinux: after every round of drawing, tell the screen what changed.
+ * This is the innermost screen block handler (it replaces KdBlockHandler,
+ * before the shadow and the software cursor wrap it), so it runs after they
+ * have drawn.
+ */
+static void
+fbdevBlockHandler(ScreenPtr pScreen, void *timeout)
+{
+    KdScreenPriv(pScreen);
+    FbdevPriv *priv = pScreenPriv->card->driver;
+
+    (*priv->BlockHandler) (pScreen, timeout);
+    if (priv->damage) {
+        RegionPtr r = DamageRegion(priv->damage);
+
+        if (RegionNotEmpty(r)) {
+            struct psifb_rect rect;
+
+            if (priv->shadow) {     /* rotated: the box is in other coordinates */
+                rect.x = rect.y = 0;
+                rect.w = priv->var.xres;
+                rect.h = priv->var.yres;
+            }
+            else {
+                BoxPtr b = RegionExtents(r);
+
+                rect.x = b->x1;
+                rect.y = b->y1;
+                rect.w = b->x2 - b->x1;
+                rect.h = b->y2 - b->y1;
+            }
+            fbdevIoctl(priv, PSIFB_DAMAGE, &rect);
+            DamageEmpty(priv->damage);
+        }
+    }
+}
